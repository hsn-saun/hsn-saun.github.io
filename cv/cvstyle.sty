% cvstyle.sty — shared layout for both CV variants.
% Compile with xelatex. Charis SIL is a Charter derivative, so the CV matches
% the typography of sontypo.github.io and still covers Vietnamese diacritics.

\ProvidesPackage{cvstyle}

\usepackage{fontspec}
\usepackage[a4paper,margin=18mm,bottom=16mm]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage{microtype}
\usepackage{fontawesome5}
\usepackage{academicons}
\usepackage[hidelinks]{hyperref}

\setmainfont{Charis SIL}[
  UprightFont = *,
  ItalicFont  = *-Italic,
  BoldFont    = *-Bold,
  Ligatures   = TeX
]
\newfontfamily\sansfont{DejaVu Sans}[Scale=0.86, Ligatures=TeX]

\definecolor{ink}{HTML}{16181B}
\definecolor{muted}{HTML}{5A6068}
\definecolor{accent}{HTML}{1F4E6B}
\definecolor{rule}{HTML}{D2D5D8}

\color{ink}
\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=accent}

\setlength{\parindent}{0pt}
\pagestyle{empty}

% ================================================================= headings
% Large, mixed case, with an accent rule — meant to be findable at a glance.
\titleformat{\section}[block]
  {\bfseries\fontsize{12.5}{15}\selectfont\color{ink}}
  {}{0pt}{}[\vspace{2pt}{\color{accent}\titlerule[1pt]}]
\titlespacing*{\section}{0pt}{14pt}{7pt}

% ================================================================== metrics
\newlength{\datecol}\setlength{\datecol}{0.175\textwidth}
\newlength{\bodycol}\setlength{\bodycol}{0.805\textwidth}
\newlength{\entrysep}\setlength{\entrysep}{9pt}

% ================================================================== entries
% \entry{dates}{title}{subtitle}   — subtitle may be empty
% Both columns share a baselineskip and open with a \strut, so the first line of
% the label sits on exactly the same baseline as the first line of the body.
\newcommand{\entry}[3]{%
  \par\addvspace{\entrysep}%
  \noindent
  \parbox[t]{\datecol}{%
    \raggedright\sansfont\fontsize{8.6}{13.5}\selectfont\strut\textcolor{muted}{#1}}%
  \hspace{0.02\textwidth}%
  \parbox[t]{\bodycol}{%
    \raggedright\bfseries\fontsize{11}{13.5}\selectfont\strut#2%
    \ifx\relax#3\relax\else
      \\[2pt]{\normalfont\color{muted}\fontsize{9.8}{12}\selectfont #3}%
    \fi}%
  \par\vspace{3pt}%
}

% indented prose under an \entry
\newenvironment{detail}
  {\begin{list}{}{%
      \setlength{\leftmargin}{\dimexpr\datecol+0.02\textwidth\relax}
      \setlength{\rightmargin}{0pt}
      \setlength{\topsep}{2pt}
      \setlength{\parsep}{0pt}
      \setlength{\itemsep}{0pt}}\item[]\fontsize{9.9}{13}\selectfont}
  {\end{list}}

\newlist{achievements}{itemize}{1}
\setlist[achievements]{
  label=\textcolor{accent}{\small\textbullet},
  leftmargin=\dimexpr\datecol+0.02\textwidth+1.1em\relax,
  labelsep=0.55em,
  topsep=3pt, itemsep=3pt, parsep=0pt, partopsep=0pt,
  before=\fontsize{9.9}{13}\selectfont
}

% ================================================================ skill rows
\newcommand{\skillrow}[2]{%
  \par\addvspace{5pt}%
  \noindent
  \parbox[t]{\datecol}{%
    \raggedright\sansfont\bfseries\fontsize{8.6}{12.8}\selectfont\strut\textcolor{muted}{#1}}%
  \hspace{0.02\textwidth}%
  \parbox[t]{\bodycol}{%
    \raggedright\fontsize{9.9}{12.8}\selectfont\strut#2}%
  \par%
}

% ============================================================== publications
% \pub{authors}{title}{venue}{link block, or empty}
\newcommand{\pub}[4]{%
  \par\addvspace{8pt}%
  \noindent
  \begin{minipage}{\textwidth}
    \bfseries\fontsize{10}{13}\selectfont #2\par
    \vspace{1pt}
    {\fontsize{9.6}{12}\selectfont\color{muted}#1}\par
    \vspace{0.5pt}
    {\itshape\fontsize{9.5}{12}\selectfont\color{muted}#3}%
    \ifx\relax#4\relax\else\ \ #4\fi
  \end{minipage}%
  \par%
}

% ===================================================================== links
\newcommand{\ilink}[3]{\href{#3}{{#1}\,\,#2}}
\newcommand{\plink}[2]{\href{#2}{\sansfont\fontsize{8.2}{10}\selectfont\faLink\,#1}}
\newcommand{\itext}[2]{{#1}\,\,#2}

\newcommand{\cpp}{C\kern-.08em\raisebox{.06ex}{\footnotesize+}\kern-.20em\raisebox{.06ex}{\footnotesize+}}

% Own name in an author list: bold *and* full-strength ink, so it separates from
% the muted co-authors by weight and by colour rather than weight alone.
\newcommand{\me}{\textbf{\textcolor{ink}{Hong-Son Nguyen}}}
